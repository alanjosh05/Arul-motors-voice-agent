[Unit]
Description=Arul Motors voice agent (Pipecat + Gemini Live on Vertex AI)
After=network-online.target
Wants=network-online.target

[Service]
User=arul
WorkingDirectory=/opt/arul-motors
# MySQL credentials etc. Vertex needs no key: the VM's service account is used.
EnvironmentFile=/opt/arul-motors/.env
# STUN lets the browser reach the VM through Google Cloud's NAT.
Environment=PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302
# Only Caddy (same machine) talks to it; WebRTC audio itself goes over UDP.
ExecStart=/opt/arul-motors/.venv/bin/python bot.py --host 127.0.0.1 --port 7860 -t webrtc --allowed-origins https://VOICE_DOMAIN
Restart=always
RestartSec=3

# Sandbox (systemd): the app can write only its own folder; the rest of the
# system is read-only or hidden; it can't gain privileges, load kernel
# modules, change kernel settings or use raw devices. A bug in the app (or a
# library) then can't be used to take over the server.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/opt/arul-motors
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
# Libraries may keep caches in the arul user's home.
ProtectHome=read-only
ReadWritePaths=-/home/arul

[Install]
WantedBy=multi-user.target
