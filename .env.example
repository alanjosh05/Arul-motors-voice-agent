# Gemini Live runs on Google Cloud Vertex AI with Application Default
# Credentials (ADC). There is NO API key: the org policy disallows them.
# Local setup, once:  gcloud auth application-default login
# Production server:  Workload Identity Federation (no key files).

# Optional: override the defaults (shown).
# GOOGLE_CLOUD_PROJECT=project-2c317546-b2c6-4a7a-8d4
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_MODEL=gemini-3.8-live

# Optional: Gemini Live voice name (default: Aoede).
# GEMINI_VOICE=Aoede
# Speech language (default ta-IN; en-US made the Tanglish sound foreign).
# GEMINI_LANGUAGE=ta-IN

# --- Real phone calls: Plivo is DISABLED for now (pending client decision) ---
# These are only read once the Plivo code is uncommented.
# Plivo credentials and the Plivo number calls are placed from.
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_PHONE_NUMBER=+91XXXXXXXXXX
# Public hostname (no scheme) that tunnels to the bot on port 7860, e.g. an
# ngrok domain. Plivo fetches https://PUBLIC_HOST/plivo/answer and streams the
# call audio to wss://PUBLIC_HOST/ws.
# PUBLIC_HOST=your-subdomain.ngrok.app
# Country code prepended to 10-digit customer numbers (default: +91).
# DEFAULT_COUNTRY_CODE=+91

# --- Database ---
# SQLite file arul_motors.db next to the code (or DB_FILE), locally and on the VM.
# Optional MySQL instead (only if several servers must share the data):
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# Encrypt the connection (verify it too by giving the CA file in MYSQL_SSL_CA).
# MYSQL_SSL=on
# MYSQL_SSL_CA=/path/to/ca.pem
# Seed the 4 demo customers into an empty database (default: on for SQLite, off for MySQL).
# SEED_DEMO=0

# --- CRM API (api.py) ---
# Signs staff logins (required in production; without it logins reset when the API restarts).
# AUTH_SECRET=
# First admin, created automatically when there are no staff users yet (optional;
# or run: python api.py create-user admin --role admin).
# CRM_ADMIN_USERNAME=admin
# CRM_ADMIN_PASSWORD=
# Optional key for scripts: X-API-Key header (the CRM uses staff logins).
# API_KEY=
# Frontend site(s) allowed to call the API from a browser, comma-separated.
# CORS_ORIGINS=https://crm.arulmotors.com
# Where api.py reaches the voice bot to relay CRM calls (same VM).
# BOT_INTERNAL_URL=http://127.0.0.1:7860

# Optional: base URL of the Pipecat voice bot, used by api.py.
# BOT_URL=http://localhost:7860
# Optional: port for api.py (default 8001, so it can run next to the hospital API).
# API_PORT=8001

# Optional: showroom timezone used for "today" / current time (default: Asia/Kolkata).
# SHOWROOM_TZ=Asia/Kolkata
